LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash
# Fallback (free): LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile

# Path to the service account key (or paste the JSON into GOOGLE_SERVICE_ACCOUNT_JSON)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
CALENDAR_ID=your-calendar-id@group.calendar.google.com
SHEET_ID=your-google-sheet-id
SHOP_TIMEZONE=America/Los_Angeles

# Phase 2 (Vapi)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
VAPI_WEBHOOK_SECRET=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
